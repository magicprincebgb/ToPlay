<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ToPlay.Host</RootNamespace>
    <AssemblyName>ToPlay.Host</AssemblyName>
    <Version>2.0.1</Version>
    <AssemblyVersion>2.0.1.0</AssemblyVersion>
    <FileVersion>2.0.1.0</FileVersion>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Performance: server GC suits a streaming workload (steady allocation
         from frame parsing/packetization) far better than workstation GC —
         fewer, faster background collections mean fewer frame-time spikes. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>

    <!-- This host is Windows 10 (1507)+ only; touch injection & desktop
         duplication are Windows-specific. Suppress the platform-compat
         analyzer rather than pulling in Windows SDK projection packs. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SIPSorcery" Version="6.2.4" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <!-- PC->phone audio: WASAPI loopback capture (NAudio) + pure-C# Opus (Concentus). -->
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="Concentus" Version="2.2.2" />
  </ItemGroup>


  <!-- Bundle a local ffmpeg.exe (dropped in ./tools by scripts/get-ffmpeg.ps1)
       into the build output so the host can find it at runtime. -->
  <ItemGroup>
    <None Include="tools\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
