# Build output
[Bb]in/
[Oo]bj/
*.user

# Installer build output (dist\ToPlaySetup.exe) + embedded payload zip
dist/
src/ToPlay.Installer/payload/

# Loose binaries / extracted downloads that sometimes land at the repo root
# (the shippable ToPlaySetup.exe lives in dist\; ffmpeg is fetched into
# src\ToPlay.Host\tools\). None of these belong in the repo.
/ToPlay.exe
/ToPlaySetup.exe
/ffmpeg-*/

# Internal / working notes kept out of the public repo (remove a line to publish it)
/READMEinside.md
/LAUNCH_POST.md

# Reference-only third-party source (Sunshine) copied into the repo for study;
# not part of ToPlay and must never be committed.
Sunshine-master/
/Sunshine-master/

# Runtime data (accounts DB, config, generated TLS cert)
**/data/
*.pfx

# Bundled ffmpeg (downloaded by scripts/get-ffmpeg.ps1)
src/ToPlay.Host/tools/

# IDE
.vs/
.vscode/
.idea/
*.suo
*.DotSettings.user

# MSBuild binary logs / publish profiles
*.binlog
*.pubxml

# Logs
*.log
*.tmp

TestResults/

# OS cruft
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store


